<Window
    x:Class="YoutubeMusicDesktop.Components.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:YoutubeMusicDesktop.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Settings"
    Width="600"
    Height="450"
    Background="#111111"
    Foreground="White"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="SingleBorderWindow"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Sidebar  -->
        <Border Grid.Column="0" Background="#0D0D0D">
            <ListBox
                x:Name="NavList"
                Margin="0,16,0,0"
                Background="Transparent"
                BorderThickness="0"
                SelectionChanged="NavList_SelectionChanged">
                <ListBox.Resources>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="#AAAAAA" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="16,10" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border
                                        x:Name="Bg"
                                        Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#0FFFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.Resources>

                <ListBoxItem Content="General" />

                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Experimental" />
                        <Border
                            Margin="8,0,0,0"
                            Padding="5,1"
                            VerticalAlignment="Center"
                            Background="#7A4400"
                            CornerRadius="3">
                            <TextBlock
                                FontSize="9"
                                FontWeight="SemiBold"
                                Foreground="#FFAA44"
                                Text="DEPRECATED" />
                        </Border>
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </Border>

        <Rectangle
            Grid.Column="0"
            Width="1"
            HorizontalAlignment="Right"
            Fill="#222222" />

        <Grid Grid.Column="1">
            <StackPanel
                x:Name="GeneralPanel"
                Margin="24,20,24,0"
                Visibility="Visible">
                <StackPanel Margin="0,0,0,24">
                    <TextBlock
                        FontSize="13"
                        Foreground="White"
                        Text="Audio Normalization" />
                    <TextBlock
                        Margin="0,2,0,8"
                        FontSize="11"
                        Foreground="#888"
                        Text="Reduce volume differences between tracks" />
                    <ui:ToggleSwitch IsChecked="False" IsEnabled="False" />
                </StackPanel>
                <StackPanel>
                    <TextBlock
                        FontSize="13"
                        Foreground="White"
                        Text="Start with Windows" />
                    <TextBlock
                        Margin="0,2,0,8"
                        FontSize="11"
                        Foreground="#888"
                        Text="Launch automatically on login" />
                    <ui:ToggleSwitch IsChecked="False" IsEnabled="False" />
                </StackPanel>
            </StackPanel>

            <StackPanel
                x:Name="ExperimentalPanel"
                Margin="24,20,24,0"
                Visibility="Collapsed">
                <TextBlock
                    FontSize="13"
                    Foreground="White"
                    Text="Theme" />
                <TextBlock
                    Margin="0,2,0,8"
                    FontSize="11"
                    Foreground="#888"
                    Text="CSS theming is not actively maintained and may break at any time."
                    TextWrapping="Wrap" />
                <ComboBox
                    x:Name="ThemeSelector"
                    Width="200"
                    HorizontalAlignment="Left"
                    DisplayMemberPath="DisplayName"
                    SelectionChanged="ThemeSelector_SelectionChanged" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
