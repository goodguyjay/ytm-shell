<Window
    Background="Black"
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    Foreground="White"
    Height="450"
    ResizeMode="NoResize"
    Title="Settings"
    Width="600"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    d:DataContext="{d:DesignInstance Type=local:SettingsWindow,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d"
    x:Class="YoutubeMusicDesktop.Components.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:YoutubeMusicDesktop.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  common resource with apptitlebar, refactor later  -->
    <Window.Resources>
        <Style TargetType="Button" x:Key="TitleBarButtonStyle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" x:Name="Bg">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="Bg" Value="#1AFFFFFF" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="Bg" Value="#33FFFFFF" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" TargetName="Bg" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            BasedOn="{StaticResource TitleBarButtonStyle}"
            TargetType="Button"
            x:Key="TitleBarCloseButtonStyle">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#C50F1F" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="36"
            GlassFrameThickness="0"
            ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Titlebar  -->
        <Grid Background="#0D0D0D" Grid.Row="0">
            <TextBlock
                FontSize="13"
                Foreground="White"
                Margin="16,0,0,0"
                Opacity="0.9"
                Text="Settings"
                TextOptions.TextFormattingMode="Display"
                TextOptions.TextRenderingMode="Grayscale"
                VerticalAlignment="Center" />

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Click="CloseButton_Click"
                    Height="36"
                    Style="{StaticResource TitleBarCloseButtonStyle}"
                    Width="46"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <Image
                        Height="10"
                        Source="{DynamicResource WinCloseIcon}"
                        Width="10" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Sidebar  -->
            <Border Background="#0D0D0D" Grid.Column="0">
                <ListBox
                    Background="Transparent"
                    BorderThickness="0"
                    Margin="0,16,0,0"
                    SelectionChanged="NavList_SelectionChanged"
                    x:Name="NavList">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="#AAAAAA" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="16,10" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            x:Name="Bg">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" TargetName="Bg" Value="#1AFFFFFF" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" TargetName="Bg" Value="#0FFFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>

                    <ListBoxItem Content="General" />

                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Experimental" VerticalAlignment="Center" />
                            <Border
                                Background="#7A4400"
                                CornerRadius="3"
                                Margin="8,0,0,0"
                                Padding="5,1"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="9"
                                    FontWeight="SemiBold"
                                    Foreground="#FFAA44"
                                    Text="DEPRECATED" />
                            </Border>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Border>

            <Rectangle
                Fill="#222222"
                Grid.Column="0"
                HorizontalAlignment="Right"
                Width="1" />

            <Grid Grid.Column="1">
                <StackPanel
                    Margin="24,20,24,0"
                    Visibility="Visible"
                    x:Name="GeneralPanel">
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock
                            FontSize="13"
                            Foreground="White"
                            Text="Audio Normalization" />
                        <TextBlock
                            FontSize="11"
                            Foreground="#888"
                            Margin="0,2,0,8"
                            Text="Reduce volume differences between tracks" />
                        <ui:ToggleSwitch IsChecked="False" IsEnabled="False" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock
                            FontSize="13"
                            Foreground="White"
                            Text="Start with Windows" />
                        <TextBlock
                            FontSize="11"
                            Foreground="#888"
                            Margin="0,2,0,8"
                            Text="Launch automatically on login" />
                        <ui:ToggleSwitch IsChecked="False" IsEnabled="False" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Margin="24,20,24,0"
                    Visibility="Collapsed"
                    x:Name="ExperimentalPanel">
                    <TextBlock
                        FontSize="13"
                        Foreground="White"
                        Text="Theme" />
                    <TextBlock
                        FontSize="11"
                        Foreground="#888"
                        Margin="0,2,0,8"
                        Text="CSS theming is not actively maintained and may break at any time."
                        TextWrapping="Wrap" />
                    <ComboBox
                        DisplayMemberPath="DisplayName"
                        HorizontalAlignment="Left"
                        SelectionChanged="ThemeSelector_SelectionChanged"
                        Width="200"
                        x:Name="ThemeSelector" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
