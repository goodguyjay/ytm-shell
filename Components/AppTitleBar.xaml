<UserControl
    x:Class="YoutubeMusicDesktop.Components.AppTitleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Height="36"
    d:DesignHeight="100"
    d:DesignWidth="700"
    Background="Black"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="TitleBarCloseButtonStyle"
            BasedOn="{StaticResource TitleBarButtonStyle}"
            TargetType="Button">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#C50F1F" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Storyboard x:Key="SoundwaveStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation
                AutoReverse="True"
                EasingFunction="{x:Null}"
                Storyboard.TargetName="Bar1Scale"
                Storyboard.TargetProperty="ScaleY"
                From="0.15"
                To="1.0"
                Duration="0:0:0.45" />
            <DoubleAnimation
                AutoReverse="True"
                BeginTime="0:0:0.1"
                Storyboard.TargetName="Bar2Scale"
                Storyboard.TargetProperty="ScaleY"
                From="0.15"
                To="1.0"
                Duration="0:0:0.35" />
            <DoubleAnimation
                AutoReverse="True"
                BeginTime="0:0:0.1"
                Storyboard.TargetName="Bar3Scale"
                Storyboard.TargetProperty="ScaleY"
                From="0.15"
                To="1.0"
                Duration="0:0:0.35" />
            <DoubleAnimation
                AutoReverse="True"
                BeginTime="0:0:0.15"
                Storyboard.TargetName="Bar4Scale"
                Storyboard.TargetProperty="ScaleY"
                From="0.15"
                To="1.0"
                Duration="0:0:0.40" />
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <StackPanel
            Margin="16,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <Canvas
                Width="22"
                Height="16"
                Margin="0,0,8,0">
                <Rectangle
                    x:Name="Bar1"
                    Canvas.Left="0"
                    Canvas.Bottom="0"
                    Width="3"
                    Height="12"
                    Fill="White"
                    Opacity="0.85"
                    RadiusX="1.5"
                    RadiusY="1.5"
                    RenderTransformOrigin="0.5,1">
                    <Rectangle.RenderTransform>
                        <ScaleTransform x:Name="Bar1Scale" ScaleY="0.3" />
                    </Rectangle.RenderTransform>
                </Rectangle>

                <Rectangle
                    x:Name="Bar2"
                    Canvas.Left="6"
                    Canvas.Bottom="0"
                    Width="3"
                    Height="12"
                    Fill="White"
                    Opacity="0.85"
                    RadiusX="1.5"
                    RadiusY="1.5"
                    RenderTransformOrigin="0.5,1">
                    <Rectangle.RenderTransform>
                        <ScaleTransform x:Name="Bar2Scale" ScaleY="0.6" />
                    </Rectangle.RenderTransform>
                </Rectangle>

                <Rectangle
                    x:Name="Bar3"
                    Canvas.Left="12"
                    Canvas.Bottom="0"
                    Width="3"
                    Height="12"
                    Fill="White"
                    Opacity="0.85"
                    RadiusX="1.5"
                    RadiusY="1.5"
                    RenderTransformOrigin="0.5,1">
                    <Rectangle.RenderTransform>
                        <ScaleTransform x:Name="Bar3Scale" ScaleY="0.45" />
                    </Rectangle.RenderTransform>
                </Rectangle>

                <Rectangle
                    x:Name="Bar4"
                    Canvas.Left="18"
                    Canvas.Bottom="0"
                    Width="3"
                    Height="12"
                    Fill="White"
                    Opacity="0.85"
                    RadiusX="1.5"
                    RadiusY="1.5"
                    RenderTransformOrigin="0.5,1">
                    <Rectangle.RenderTransform>
                        <ScaleTransform x:Name="Bar4Scale" ScaleY="0.2" />
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Canvas>

            <!--  The title text will be set dynamically in the code-behind, placeholder for now  -->
            <TextBlock
                x:Name="TitleText"
                VerticalAlignment="Center"
                FontSize="13"
                Foreground="White"
                Opacity="0.9"
                Text="Youtube Music" />
        </StackPanel>

        <StackPanel
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Orientation="Horizontal">
            <Button
                x:Name="SettingsButton"
                Width="46"
                Height="36"
                Click="SettingsButton_Click"
                Style="{StaticResource TitleBarButtonStyle}"
                WindowChrome.IsHitTestVisibleInChrome="True">
                <Image
                    Width="14"
                    Height="14"
                    Opacity="0.85"
                    Source="{DynamicResource SettingsIcon}" />
            </Button>

            <Button
                x:Name="MinimizeButton"
                Width="46"
                Height="36"
                Click="MinimizeButton_Click"
                Style="{StaticResource TitleBarButtonStyle}"
                WindowChrome.IsHitTestVisibleInChrome="True">
                <Image
                    Width="10"
                    Height="10"
                    Source="{DynamicResource WinMinimizeIcon}" />
            </Button>

            <Button
                x:Name="MaximizeButton"
                Width="46"
                Height="36"
                Click="MaximizeButton_Click"
                Style="{StaticResource TitleBarButtonStyle}"
                WindowChrome.IsHitTestVisibleInChrome="True">
                <Image
                    x:Name="MaximizeIcon"
                    Width="10"
                    Height="10"
                    Source="{DynamicResource WinMaximizeIcon}" />
            </Button>

            <Button
                x:Name="CloseButton"
                Width="46"
                Height="36"
                Click="CloseButton_Click"
                Style="{StaticResource TitleBarButtonStyle}"
                WindowChrome.IsHitTestVisibleInChrome="True">
                <Image
                    Width="10"
                    Height="10"
                    Source="{DynamicResource WinCloseIcon}" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
